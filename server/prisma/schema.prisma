datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  password     String
  name         String
  role         String           @default("STUDENT") // STUDENT, STAFF, ADMIN
  department   String?          // e.g. Hostel, Academics, IT, Finance
  phone        String?
  avatar       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  createdTickets  Ticket[]         @relation("StudentTickets")
  assignedTickets Ticket[]         @relation("StaffTickets")
  activities      TicketActivity[]
}

model Ticket {
  id              String           @id @default(uuid())
  ticketCode      String           @unique
  title           String
  description     String
  category        String           // ACADEMICS, HOSTEL, TRANSPORT, FEE, IT, GENERAL
  priority        String           @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  status          String           @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, PENDING_STUDENT_INFO, RESOLVED, CLOSED
  slaHours        Int              @default(24)
  slaDueDate      DateTime
  isSlaBreached   Boolean          @default(false)

  studentId       String
  student         User             @relation("StudentTickets", fields: [studentId], references: [id])

  assignedStaffId String?
  assignedStaff   User?            @relation("StaffTickets", fields: [assignedStaffId], references: [id])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  activities      TicketActivity[]
  attachments     Attachment[]
}

model TicketActivity {
  id             String   @id @default(uuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId         String
  user           User     @relation(fields: [userId], references: [id])

  action         String   // CREATED, STATUS_CHANGED, ASSIGNED, PRIORITY_CHANGED, COMMENT, REOPENED
  fieldChanged   String?
  oldValue       String?
  newValue       String?
  comment        String?
  isInternalNote Boolean  @default(false)

  createdAt      DateTime @default(now())
}

model Attachment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  mimeType  String?
  fileSize  Int?
  createdAt DateTime @default(now())
}
